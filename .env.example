OPSGRAPH_PROFILE=local
OPSGRAPH_MODEL_PROVIDER=fake
OPSGRAPH_DATABASE_URL=sqlite+pysqlite:///:memory:
OPSGRAPH_MAX_TOOL_CALLS=6
OPSGRAPH_LOCAL_ADMIN_TOKEN=replace-with-a-local-development-token
OPSGRAPH_MAX_UPLOAD_BYTES=2000000
OPSGRAPH_MAX_PDF_PAGES=20
OPSGRAPH_RESPONSE_CACHE_SECONDS=300
OPSGRAPH_TELEMETRY_ENABLED=false
OPSGRAPH_TELEMETRY_EXPORTER=otlp
OPSGRAPH_TELEMETRY_SERVICE_NAME=opsgraph-api
OPSGRAPH_OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Optional local model profile
OPSGRAPH_OLLAMA_BASE_URL=http://localhost:11434
OPSGRAPH_OLLAMA_MODEL=qwen3:4b

# Optional AWS demo profile; credentials come from the normal AWS identity chain.
OPSGRAPH_AWS_REGION=ap-southeast-2
OPSGRAPH_BEDROCK_MODEL_ID=
